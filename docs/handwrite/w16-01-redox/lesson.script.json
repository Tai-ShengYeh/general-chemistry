          "size": 86,
          "font": "marker",
          "anim": "write",
          "at": 0.15
        },
        {
          "type": "text",
          "id": "step1",
          "text": "電位基準、pH與條件要一致",
          "x": 190,
          "y": 330,
          "size": 68,
          "font": "hand",
          "anim": "write"
        },
        {
          "type": "text",
