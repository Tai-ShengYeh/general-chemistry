          "y": 330,
          "size": 68,
          "font": "hand",
          "anim": "write"
        },
        {
          "type": "text",
          "id": "step2",
          "text": "0.26×4.20 = 1.092",
          "x": 190,
          "y": 453,
          "size": 68,
          "font": "hand",
          "anim": "write"
        }
      ],
      "hold": 4,
      "center": false,
      "min_dur": 0
    },
    {
      "narration": "差值零點二六保留到小數第二位，只有兩位有效數字。再乘四點二零，結果依兩位有效數字報一點一。有效數字是入門規則，正式不確定度評估還要追蹤各誤差來源。",
      "items": [
        {
          "type": "text",
          "id": "heading",
