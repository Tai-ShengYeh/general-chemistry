    {
      "narration": "pH高於等電點，去質子化程度較高，蛋白質通常呈淨負電。這是整體平均淨電荷，不是每個胺基酸側鏈都帶負電。",
      "items": [
        {
          "type": "text",
          "id": "heading",
          "text": "答案：通常淨負電",
          "x": 170,
          "y": 145,
          "size": 86,
          "font": "marker",
          "anim": "write",
          "at": 0.15
        },
        {
          "type": "text",
          "id": "step1",
          "text": "pH > pI → 通常淨負電",
          "x": 190,
          "y": 330,
          "size": 68,
          "font": "hand",
          "anim": "write"
        },
        {
          "type": "text",
          "id": "step2",
          "text": "部分基團仍可帶正電或不帶電",
          "x": 190,
          "y": 453,
          "size": 68,
          "font": "hand",
          "anim": "write"
        }
