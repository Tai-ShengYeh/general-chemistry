          "anim": "write",
          "at": 0.15
        },
        {
          "type": "text",
          "id": "step1",
          "text": "aw＝14.3 torr/23.8 torr",
          "x": 190,
          "y": 330,
          "size": 68,
          "font": "hand",
          "anim": "write"
        }
      ],
      "hold": 4,
      "center": false,
      "min_dur": 0
