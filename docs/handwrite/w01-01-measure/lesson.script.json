        {
          "type": "text",
          "id": "step1",
          "text": "0.05080 g",
          "x": 190,
          "y": 330,
          "size": 68,
          "font": "hand",
          "anim": "write"
        },
        {
          "type": "text",
          "id": "step2",
          "text": "2 位？3 位？4 位？",
          "x": 190,
          "y": 453,
          "size": 68,
          "font": "hand",
          "anim": "write"
