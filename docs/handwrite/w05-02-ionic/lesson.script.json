          "y": 330,
          "size": 68,
          "font": "hand",
          "anim": "write"
        },
        {
          "type": "text",
          "id": "step2",
          "text": "→ AgCl(s)＋Na⁺＋NO₃⁻",
          "x": 190,
          "y": 453,
          "size": 68,
          "font": "hand",
          "anim": "write"
        }
      ],
      "hold": 4,
      "center": false,
      "min_dur": 0
    },
    {
      "narration": "消去兩側相同的鈉離子與硝酸根，得到銀離子加氯離子，形成氯化銀固體。檢查總電荷零，銀和氯原子也各一。",
      "items": [
        {
          "type": "text",
          "id": "heading",
          "text": "答案：消去鈉與硝酸根",
