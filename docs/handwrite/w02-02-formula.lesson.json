      "items": [],
      "pause": true,
      "answer": "Mg(NO₃)₂。"
    },
    {
      "title": "答案：Mg(NO₃)₂",
      "narration": "一個鎂離子，配兩個硝酸根。總電荷正二加負二，等於零。括號外的二要乘到整個硝酸根，所以一個式量單位中有兩個氮與六個氧。",
      "steps": [
        "(+2)＋2(−1) = 0",
        "Mg(NO₃)₂",
        "Mg 1、N 2、O 6"
      ],
      "stage": "answer",
      "wait": 1.3,
      "source_slides": [
        2,
        40,
        63
      ],
      "items": []
    },
    {
      "title": "1000 mg 碳酸鈣，不等於1000 mg鈣",
      "narration": "碳酸鈣的莫耳質量約一百點零九公克每莫耳，其中鈣約四十點零八。鈣的質量分率約百分之四十。這裡算的是標示的化合物成分，不是在給補充劑用量建議。",
      "steps": [
        "CaCO₃：約 100.09 g/mol",
        "鈣分率＝40.08÷100.09 ≈ 0.400",
        "1000 mg 化合物 → 約400 mg鈣"
