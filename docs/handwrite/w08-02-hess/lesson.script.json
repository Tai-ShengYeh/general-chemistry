  "scenes": [
    {
      "narration": "同樣的起點與終點，不管分幾步反應，總焓變相同。加總反應式時，中間物可以消去，對應焓變也要一起相加。這是Hess定律。",
      "items": [
        {
          "type": "text",
          "id": "heading",
          "text": "焓變，跟起終點有關",
          "x": 170,
          "y": 145,
          "size": 86,
          "font": "marker",
          "anim": "write",
          "at": 0.15
        },
        {
          "type": "text",
          "id": "step1",
          "text": "反應式相加 → 焓變相加",
          "x": 190,
          "y": 330,
          "size": 68,
          "font": "hand",
          "anim": "write"
        },
        {
          "type": "text",
          "id": "step2",
          "text": "反寫反應 → 焓變反號",
          "x": 190,
          "y": 453,
          "size": 68,
          "font": "hand",
          "anim": "write"
        },
        {
          "type": "text",
          "id": "step3",
          "text": "係數乘倍 → 焓變也乘倍",
          "x": 190,
          "y": 576,
          "size": 68,
          "font": "hand",
          "anim": "write"
        },
        {
          "type": "text",
          "text": "năng lượng · 能量",
