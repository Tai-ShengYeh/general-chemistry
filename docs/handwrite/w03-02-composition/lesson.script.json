  "scenes": [
    {
      "narration": "營養標示的鈉，不等於氯化鈉。若假設這些鈉全部來自氯化鈉，就能依莫耳質量比例換算氯化鈉當量。真實食品也可能有其他含鈉化合物。",
      "items": [
        {
          "type": "text",
          "id": "heading",
          "text": "元素標示，要換成化合物",
          "x": 170,
          "y": 145,
          "size": 86,
          "font": "marker",
          "anim": "write",
          "at": 0.15
        },
        {
          "type": "text",
          "id": "step1",
          "text": "NaCl中：Na約22.99 g/mol",
          "x": 190,
          "y": 330,
          "size": 68,
          "font": "hand",
          "anim": "write"
        },
        {
          "type": "text",
          "id": "step2",
          "text": "NaCl約58.44 g/mol",
          "x": 190,
          "y": 453,
          "size": 68,
          "font": "hand",
          "anim": "write"
        },
        {
          "type": "text",
          "id": "step3",
          "text": "先說明：以氯化鈉當量換算",
          "x": 190,
          "y": 576,
          "size": 68,
          "font": "hand",
          "anim": "write"
        },
        {
          "type": "text",
          "text": "thành phần · 組成",
