  "scenes": [
    {
      "narration": "先選定系統，再判斷熱流方向。系統吸熱，熱量是正；系統放熱，熱量是負。熱是跨邊界傳遞的能量，不是物體裡存著一包叫熱的東西。",
      "items": [
        {
          "type": "text",
          "id": "heading",
          "text": "正負號，站在系統這一邊",
          "x": 170,
          "y": 145,
          "size": 86,
          "font": "marker",
          "anim": "write",
          "at": 0.15
        },
        {
          "type": "text",
          "id": "step1",
          "text": "吸熱：q系統 > 0",
          "x": 190,
          "y": 330,
          "size": 68,
          "font": "hand",
          "anim": "write"
        },
        {
          "type": "text",
          "id": "step2",
          "text": "放熱：q系統 < 0",
          "x": 190,
          "y": 453,
          "size": 68,
          "font": "hand",
          "anim": "write"
        },
        {
          "type": "text",
          "text": "nhiệt · 熱",
          "x": 180,
          "y": 265,
          "size": 34,
          "at": 0.5,
