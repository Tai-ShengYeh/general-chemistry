      "source_slides": [
        1,
        2,
        3
      ],
      "wait": 1.4
    },
    {
      "title": "換算表：數字要跟著單位",
      "narration": "本課使用美制體積。盎司和磅量質量，液量盎司和杯量體積。表上的換算數值採課堂近似值，不把四捨五入後的數字當作精確定義。",
      "stage": "explain",
      "steps": [
        "1 lb ≈ 453.59 g",
        "1 oz ≈ 28.35 g",
        "1 fl oz ≈ 29.57 mL",
        "1 cup ≈ 236.6 mL"
      ],
      "source_slides": [
        5,
        6
      ],
      "wait": 1.4
    },
    {
      "title": "12 oz，能直接當 355 mL？",
      "narration": "食譜寫十二盎司，沒有液量的英文縮寫。你能直接把它當成三百五十五毫升嗎？先說出它量的是質量還是體積。",
      "stage": "practice",
      "steps": [
        "12 oz → 質量？體積？",
        "12 fl oz 又是什麼？"
      ],
      "source_slides": [
        5,
        8
      ],
      "wait": 4,
      "pause": true,
      "answer": "oz 是質量；fl oz 是體積，不能混用。"
    },
    {
      "title": "先分清楚，才開始算",
      "narration": "十二盎司是約三百四十公克。十二液量盎司才是約三百五十五毫升。若要把牛奶的公克換成毫升，還需要密度。",
      "stage": "answer",
      "steps": [
        {
          "text": "oz：質量；fl oz：體積",
          "emphasis": "box"
        },
        "12 oz ≈ 340 g",
        "12 fl oz ≈ 355 mL",
        "質量 ↔ 體積，需要密度"
      ],
      "source_slides": [
        5,
        8
      ],
      "wait": 1.4
    },
    {
      "title": "例 1：150 lb 換成 kg",
      "narration": "研究中的體重是一百五十磅。計算每公斤體重的攝取量前，先換成公斤。請先寫出路線，不要先算數字。",
