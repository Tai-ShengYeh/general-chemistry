          "text": "催化劑：改速度",
          "x": 190,
          "y": 330,
          "size": 68,
          "font": "hand",
          "anim": "write"
        },
        {
          "type": "text",
          "id": "step2",
          "text": "同溫同反應：K不變",
          "x": 190,
          "y": 453,
          "size": 68,
          "font": "hand",
          "anim": "write"
        }
      ],
      "hold": 1.3,
      "center": false,
      "min_dur": 0
