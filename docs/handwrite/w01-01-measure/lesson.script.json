      ],
      "hold": 4,
      "center": false,
      "min_dur": 0
    },
    {
      "narration": "答案是四位。開頭兩個零不算，五和八之間的零要算。小數後、非零數字右邊的末尾零，也有測量位數的意義。",
      "items": [
        {
          "type": "text",
          "id": "heading",
          "text": "答案：四位",
          "x": 170,
          "y": 145,
          "size": 86,
          "font": "marker",
          "anim": "write",
          "at": 0.15
        },
        {
          "type": "text",
          "id": "step1",
          "text": "0.05080 → 5、0、8、0",
          "x": 190,
          "y": 330,
          "size": 68,
          "font": "hand",
          "anim": "write"
        },
        {
          "type": "text",
          "id": "step2",
          "text": "共 4 位有效數字",
          "x": 190,
          "y": 453,
          "size": 68,
