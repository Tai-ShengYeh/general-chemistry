          "x": 190,
          "y": 453,
          "size": 68,
          "font": "hand",
          "anim": "write"
        }
      ],
      "hold": 4,
      "center": false,
      "min_dur": 0
    },
    {
      "narration": "食品分類界線與酪蛋白等電點，有不同的定義與依據。數字接近只是巧合。酸凝也不是把pH調回來就保證完全復原，因為聚集、加熱與加工可能帶來不可逆變化。",
      "items": [
        {
          "type": "text",
          "id": "heading",
          "text": "相同數字，不是相同理由",
