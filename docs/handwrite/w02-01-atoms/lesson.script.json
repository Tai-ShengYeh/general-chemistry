        },
        {
          "type": "text",
          "id": "step2",
          "text": "中子：56−26 = 30",
          "x": 190,
          "y": 453,
          "size": 68,
          "font": "hand",
          "anim": "write"
        },
        {
          "type": "text",
          "id": "step3",
