          "text": "蜂蜜偏移：−23−(−25)=2.0‰",
          "x": 190,
          "y": 330,
          "size": 68,
          "font": "hand",
          "anim": "write"
        },
        {
          "type": "text",
          "id": "step2",
          "text": "完整距離：−9.7−(−25)=15.3‰",
          "x": 190,
          "y": 453,
          "size": 68,
          "font": "hand",
          "anim": "write"
        },
        {
          "type": "text",
          "id": "step3",
          "text": "2.0÷15.3×100 ≈ 13.1%",
