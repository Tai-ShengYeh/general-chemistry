          "type": "text",
          "id": "heading",
          "text": "負的δ，不是負的同位素量",
          "x": 170,
          "y": 145,
          "size": 86,
          "font": "marker",
          "anim": "write",
          "at": 0.15
        },
        {
          "type": "text",
          "id": "step1",
          "text": "δ＝(R樣品/R標準−1)×1000‰",
          "x": 190,
          "y": 330,
          "size": 68,
